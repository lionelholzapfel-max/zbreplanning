{
  "name": "zbreplanning",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:test": "env $(grep -v '^#' .env.test | grep -v '^$' | xargs) next dev --port 3003",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "design:shots": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/design-shots.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.104.1",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "date-fns": "^4.4.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^5.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^18.0.1",
    "eslint": "^10",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.0"
  }
}